{Array.from({length:13},(_,i)=><g><path d={`M${52+i*26} 186l13 23 13-23`} stroke="currentColor" opacity=".35"/><circle cx={52+i*26} cy="186" r="2.5" fill="currentColor"/><circle cx={65+i*26} cy="209" r="2.5" fill="var(--topic-color)"/></g>)}
<path d="M50 186h315M64 209h312" stroke="currentColor" opacity=".3"/>
</> : <>
<path d="M43 192H380M63 210V42" stroke="currentColor" opacity=".5"/>
{[0,1,2,3,4].map(i=><path d={`M65 ${175-i*8}C130 ${180-i*30},155 ${35+i*10},219 ${63+i*20}S315 ${185-i*23},368 ${60+i*17}`} stroke={i===2?'var(--topic-color)':'currentColor'} opacity={i===2?1:.3} stroke-width={i===2?1.8:1}/>)}
{Array.from({length:7},(_,i)=><g><path d={`M${90+i*40} 48V193`} stroke="currentColor" stroke-dasharray="2 5" opacity=".15"/><circle cx={90+i*40} cy={123-Math.sin(i*.9)*52} r="3" fill="var(--topic-color)"/></g>)}
<path d="M293 28h75m-75 8h55" stroke="currentColor" opacity=".3"/>
</>}
</svg>
