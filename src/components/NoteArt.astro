---
const {kind}=Astro.props;
---
<svg viewBox="0 0 420 245" fill="none" aria-hidden="true" class="note-art">
{kind==='physics' ? <>
<path d="M48 68H156M102 68v111M102 68L63 158M102 68l65 75" stroke="currentColor" stroke-width="1.2"/>
<path d="M63 158Q109 205 167 143" stroke="currentColor" stroke-dasharray="3 4" opacity=".5"/>
<circle cx="102" cy="68" r="3" fill="currentColor"/><circle cx="63" cy="158" r="9" fill="#f4f1e8" stroke="currentColor"/><circle cx="102" cy="179" r="9" fill="#f4f1e8" stroke="currentColor"/><circle cx="167" cy="143" r="9" fill="#f4f1e8" stroke="currentColor"/>
<ellipse cx="289" cy="102" rx="77" ry="37" transform="rotate(-27 289 102)" stroke="currentColor"/><ellipse cx="289" cy="102" rx="52" ry="70" transform="rotate(32 289 102)" stroke="currentColor" stroke-dasharray="2 4" opacity=".45"/><circle cx="289" cy="102" r="4" fill="currentColor"/><circle cx="343" cy="66" r="5" fill="#f4f1e8" stroke="currentColor"/>
<path d="M206 195h174" stroke="currentColor" opacity=".3"/><path d={Array.from({length:181},(_,i)=>`${i?'L':'M'}${205+i} ${195-Math.sin(i*.36)*Math.exp(-(((i-90)/40)**2))*24}`).join(' ')} stroke="var(--topic-color)" stroke-width="1.3"/>
