---
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths(){const modules=import.meta.glob('../../content/notes/*.md',{eager:true});return Object.entries(modules).map(([path,note])=>({params:{slug:path.split('/').pop()!.replace('.md','')},props:{note}}));}
const {note}=Astro.props;const {Content,frontmatter, getHeadings}=note;const headings=getHeadings().filter((h:any)=>h.depth<=2);
---
<Layout title={frontmatter.title+' — Shaoyun Wang'}><section class="wrap note-heading"><a class="text-link" href="/notes/">← All notes</a><div class="eyebrow">{frontmatter.category} · {frontmatter.date}</div><h1>{frontmatter.title}</h1></section><div class="wrap article-grid"><aside class="toc"><span class="eyebrow">ON THIS PAGE</span><nav aria-label="Table of contents">{headings.map((h:any)=><a href={'#'+h.slug}>{h.text}</a>)}</nav><a class="text-link" href="/notes/">← Back to notebook</a></aside><article class="prose"><Content/></article></div></Layout>
