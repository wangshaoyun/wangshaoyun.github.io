---
import Layout from '../layouts/Layout.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import papers from '../data/publications.json';
import Project from '../components/Project.astro';
import EnvironmentDiagram from '../components/EnvironmentDiagram.astro';
import '../styles/home-cover.css';
const researchIntro='I engineer interactions between physical systems and their environments to realize unconventional effective dynamics. Through active metamaterials, I create platforms to explore new wave physics.';
---
<Layout description={researchIntro} pageClass="home-cover-preview"><section class="hero environment-hero environment-hero-clean wrap"><div class="hero-copy"><h1>Engineering<br/>environments.<br/><em>Exploring new wave physics.</em></h1><p class="intro">{researchIntro}</p><div class="hero-links"><a class="button" href="/research/">Explore my research <span>↗</span></a><a class="text-link" href={profile.scholar}>Google Scholar ↗</a></div></div><EnvironmentDiagram/></section>
<section class="wrap section"><div class="section-heading"><div><span class="eyebrow">A FEW THREADS OF MY WORK</span><h2>Selected research</h2></div><a class="text-link" href="/research/">All research ↗</a></div><div class="projects">{projects.filter(p=>p.featured).map((project,index)=><Project project={project} index={index}/>)}</div></section>
<section class="publications-band"><div class="wrap section"><div class="section-heading"><div><span class="eyebrow">FROM THEORY TO EXPERIMENT</span><h2>Recent publications</h2></div><a class="text-link" href="/publications/">All publications ↗</a></div>{papers.slice(0,4).map(p=><article class="recent-paper"><span class="year">{p.year}</span><div><a href={p.url}>{p.title}</a><p>{p.venue}</p></div><a class="arrow-link" href={p.url} aria-label={'Read '+p.title}>↗</a></article>)}</div></section>
<section class="wrap notebook-banner"><div><span class="eyebrow">THE WORK BEHIND THE WORK</span><h2>An open notebook.</h2><p>Derivations, computational methods, and ideas collected along the way.</p></div><a class="button secondary" href="/notes/">Browse research notes ↗</a></section>
</Layout>
