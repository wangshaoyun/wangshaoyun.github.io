---
import Layout from '../layouts/Layout.astro';
import papers from '../data/publications.json';
const years=[...new Set(papers.map(p=>p.year))];
---
<Layout title="Publications — Shaoyun Wang"><section class="wrap page-heading"><span class="eyebrow">PAPERS & PREPRINTS</span><h1>Publications<span class="count">{papers.length}</span></h1><p>Work on elastic waves, metamaterials, computational mechanics, and soft matter.</p><a class="text-link" href="https://scholar.google.com/citations?user=oqbB9WkAAAAJ&hl=en">View Google Scholar ↗</a></section><section class="wrap publications-section"><div class="filters"><div class="segmented"><button data-mode="all" class="active" aria-pressed="true">All publications</button><button data-mode="selected" aria-pressed="false">Selected</button></div><label class="year-select">Year <select id="year-filter"><option value="all">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label class="search-label"><span class="sr-only">Search publications</span><input id="paper-search" type="search" placeholder="Search title or author…"/></label></div><p id="results-count" class="results" aria-live="polite">{papers.length} publications</p><div>{papers.map(p=><article class="paper" data-year={p.year} data-selected={String(p.selected)} data-search={(p.title+' '+p.authors+' '+p.venue).toLowerCase()}><span class="year">{p.year}</span><div><h2><a href={p.url}>{p.title}</a></h2><p class="authors">{p.authors.split(/(Shaoyun Wang|S\. Y\.\s*Wang|S\. Wang|Wang, S\.)/g).map(s=>/^(Shaoyun Wang|S\. Y\.\s*Wang|S\. Wang|Wang, S\.)$/.test(s)?<strong>{s}</strong>:s)}</p><p class="venue">{p.venue}</p><div class="paper-links"><a href={p.url}>Publisher ↗</a>{p.pdf&&<a href={p.pdf}>PDF ↓</a>}<a href={'/citations/'+p.id+'.bib'} download>BibTeX ↓</a>{p.selected&&<span class="selected-tag">Selected work</span>}</div></div></article>)}</div><p id="empty" hidden>No publications match. Try another year or search term.</p></section></Layout>
<script>
let mode='all';const year=document.querySelector<HTMLSelectElement>('#year-filter')!;const search=document.querySelector<HTMLInputElement>('#paper-search')!;
function filter(){let count=0;document.querySelectorAll<HTMLElement>('.paper').forEach(p=>{const visible=(mode==='all'||p.dataset.selected==='true')&&(year.value==='all'||p.dataset.year===year.value)&&p.dataset.search!.includes(search.value.toLowerCase().trim());p.hidden=!visible;if(visible)count++;});document.querySelector('#results-count')!.textContent=`${count} publication${count===1?'':'s'}`;document.querySelector<HTMLElement>('#empty')!.hidden=count>0;}
document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode!;document.querySelectorAll('[data-mode]').forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b))});filter()}));year.addEventListener('change',filter);search.addEventListener('input',filter);
</script>
